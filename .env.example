# Copy to .env.local for development. Everything below is server-only unless stated otherwise.

# --- Supabase (Auth + Postgres via REST) -------------------------------------------------------
# Project URL. Must be https:// in production. Local stack: http://127.0.0.1:54321
SUPABASE_URL=
# Anon key: safe to expose by design, but the app only uses it on the server.
SUPABASE_ANON_KEY=
# Service role key: bypasses RLS. Used only for form submissions, AI usage accounting and
# scripts/access-codes.mjs. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Form notifications (optional) ------------------------------------------------------------
# A form reports success only if the database or Telegram accepted it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=

# --- AI advisor (optional, disabled by default) -----------------------------------------------
# Any OpenAI-compatible chat completions endpoint. All four values are required to enable it.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Hard daily cap across all users. 0 keeps the AI advisor off.
AI_DAILY_GLOBAL_LIMIT=0
AI_DAILY_LIMIT_PER_USER=5
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_MS=15000

# --- Google Sheets, read-only (scripts/test-google-sheets.mjs) --------------------------------
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=
# Keep readonly. Write access is intentionally not supported.
GOOGLE_SHEETS_ACCESS_MODE=readonly
