# Temporary MVP access code. Replace before production traffic.
PRO_ACCESS_CODE=

# Optional cookie name override.
PRO_ACCESS_COOKIE_NAME=business-reboot-pro-access

# Server-only secret used to sign PRO access cookies. Use a long random value.
PRO_ACCESS_SECRET=

# Supabase project URL and anon key. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only Telegram notifications for leads, partners and feedback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=

# Server-only Google Sheets read access (dedicated service account).
# Path to the service account JSON key file. Never commit the key file.
GOOGLE_APPLICATION_CREDENTIALS=
# Master spreadsheet "Таблицы_и_расчёты_для_бизнеса".
GOOGLE_SHEETS_SPREADSHEET_ID=
# Keep readonly. Write access is intentionally not supported.
GOOGLE_SHEETS_ACCESS_MODE=readonly
